{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python3 -B \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/tools/kynfra/plugins/kynfra/scripts/session_start.py\"", "timeout": 30 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|Write|Edit",
        "hooks": [
          { "type": "command", "command": "python3 -B \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/tools/kynfra/plugins/kynfra/scripts/pre_write.py\"", "timeout": 30, "statusMessage": "kynfra: checking infrastructure rules" }
        ]
      },
      {
        "matcher": "Bash|shell|exec_command|local_shell",
        "hooks": [
          { "type": "command", "command": "python3 -B \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/tools/kynfra/plugins/kynfra/scripts/bash_guard.py\"", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Write|Edit",
        "hooks": [
          { "type": "command", "command": "python3 -B \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/tools/kynfra/plugins/kynfra/scripts/post_edit.py\"", "timeout": 60 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 -B \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/tools/kynfra/plugins/kynfra/scripts/stop_gate.py\"", "timeout": 900, "statusMessage": "kynfra: fmt, validate, lint, scanner, architecture" }
        ]
      }
    ]
  }
}
